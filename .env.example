# Copy to .env and fill in. .env is gitignored; this template is committed.
# Credentials for the Southwark puller spike (puller/).

# Companies House — Tasks 0, 2, 3. Free key:
# https://developer.company-information.service.gov.uk/
CH_API_KEY=

# EPC Open Data — Task 1 (pressure universe). Registration returns a single
# pre-encoded token. EPC's UI calls it a "Bearer token", but it is sent as
# `Authorization: Basic <token>` verbatim — do NOT build a Basic header from
# an email:key pair. https://epc.opendatacommunities.org/
EPC_API_KEY=
